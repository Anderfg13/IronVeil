# Copia este archivo a .env antes de levantar el entorno:
#   cp .env.example .env
#
# .env nunca debe subirse al repositorio (ver .gitignore).

# Puerto publicado en el host para el proxy FastAPI.
PROXY_PORT=8000

# Modelo base de Ollama sobre el que se construyen "soporte" y "rrhh".
# Puedes usar una variante mas liviana como llama3.2:1b para pruebas rapidas.
BASE_MODEL=llama3.2

# Modelo clasificador (mecanismo 3, direccion "salida") usado por
# clasificar() en mecanismos.py, via Ollama. llama-guard3:1b (1.6GB) es la
# variante liviana del registro de Ollama; la variante completa es
# llama-guard3:8b (o llama-guard3 a secas, 4.9GB).
MODELO_CLASIFICADOR=llama-guard3:1b

# Modelo clasificador (mecanismo 3, direccion "entrada") usado por
# clasificar() -- via Hugging Face, NO via Ollama (es un clasificador, no
# un modelo de chat). Llama Prompt Guard 2 86M (~0.3GB), entrenado
# especificamente para prompt injection / jailbreak.
MODELO_PROMPT_GUARD_ID=meta-llama/Llama-Prompt-Guard-2-86M

# Token de acceso de Hugging Face. OBLIGATORIO para mecanismo 3 en
# direccion "entrada": Prompt Guard tiene licencia restringida (hay que
# aceptarla en https://huggingface.co/meta-llama/Llama-Prompt-Guard-2-86M
# con una cuenta, y generar el token en Settings > Access Tokens, tipo
# "Read"). Sin este valor, clasificar() en entrada falla cerrado (unsafe)
# en cada peticion -- no rompe el proxy, pero bloquea todo si `clasificacion`
# esta activa. NUNCA subir el valor real de esta variable, solo vive en
# tu .env local.
HF_TOKEN=

# Cuanto tiempo mantiene Ollama un modelo cargado en memoria tras la
# ultima peticion antes de descargarlo (parametro nativo de la API de
# Ollama, formato "30m"/"1h"/"-1" para nunca descargar). Default de Ollama
# es 5m; se sube a 30m para que una pausa entre peticiones (demo en vivo,
# bateria de ataques con huecos) no fuerce una recarga en frio del modelo.
OLLAMA_KEEP_ALIVE=30m
# Modelos que Ollama mantiene cargados a la vez (evita recargas que alargan la cola de
# latencia). 3 = valor por defecto de Ollama; 4 solo con memoria de sobra.
OLLAMA_MAX_LOADED_MODELS=3
# Latencia del clasificador SIN cambiar lo que revisa: Llama Guard solo necesita unos
# tokens para decir safe/unsafe + categorias; Prompt Guard usa fp16 si hay GPU CUDA
# (0 para volver a fp32). NO se trunca el texto ni se reduce num_ctx: dejarian
# partes del texto sin revisar.
LLAMA_GUARD_MAX_TOKENS=32
PROMPT_GUARD_FP16=1

# Adaptador del clasificador: como se traduce lo que dice el modelo a "malicioso / no".
# Con el modelo actual NO hace falta tocar nada (todo vacio). Solo al cambiar de modelo;
# pasos en docs/CAMBIAR_MODELO_CLASIFICADOR.md. Una etiqueta desconocida bloquea.
#   Backend de entrada (por ahora solo existe huggingface):
CLASIFICADOR_ENTRADA_BACKEND=huggingface
#   Si el modelo nuevo usa etiquetas genericas (LABEL_0...), declara cuales son maliciosas
#   y cuales benignas (las dos; varias separadas por comas):
CLASIFICADOR_ENTRADA_ETIQUETAS_MALICIOSAS=
CLASIFICADOR_ENTRADA_ETIQUETAS_BENIGNAS=
#   Si el modelo de salida no contesta safe/unsafe (primera linea de su respuesta):
CLASIFICADOR_SALIDA_VEREDICTOS_INSEGUROS=
CLASIFICADOR_SALIDA_VEREDICTOS_SEGUROS=

# Otros backends de entrada (CLASIFICADOR_ENTRADA_BACKEND = http | ollama | openai |
# anthropic | jev). 'http' es un clasificador servido por HTTP (p. ej. Prompt Guard
# desplegado en la nube de tu organizacion): URL_BASE es la direccion completa.
# Recetas y advertencias en docs/CAMBIAR_MODELO_CLASIFICADOR.md.
#   Modelo (ollama / openai / anthropic) y, si hace falta, destino y clave. La URL base
#   de 'openai' sirve tambien para un servidor LOCAL (LM Studio, vLLM). Parametros extra:
#   objeto JSON que reemplaza los del cuerpo (p. ej. {"max_completion_tokens": 16}).
CLASIFICADOR_ENTRADA_MODELO=
CLASIFICADOR_ENTRADA_URL_BASE=
CLASIFICADOR_ENTRADA_API_KEY=
CLASIFICADOR_ENTRADA_PARAMETROS_EXTRA=
#   Jev (TypeSafe, remoto). Umbral: se bloquea si la probabilidad de inyeccion es >= este
#   valor (0-1). El 0.5 es una eleccion nuestra, no de su documentacion: calibralo.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai
JEV_MODELO=jev-latest
JEV_UMBRAL=0.5
#   PERMISO para usar un backend REMOTO. Vacio = apagado (por defecto). Con 1, el texto de
#   cada peticion se envia a un tercero, FUERA del laboratorio; solo con aprobacion del
#   equipo y dejandolo anotado (docs/CONFLICTOS_RESUELTOS.md, conflicto 5).
CLASIFICADOR_PERMITIR_REMOTO=
#   Hosts de TU organizacion (nombres exactos, separados por comas), p. ej. un Prompt Guard
#   en tu nube. No necesitan el permiso de arriba, pero si https y CLASIFICADOR_ENTRADA_API_KEY.
CLASIFICADOR_HOSTS_PROPIOS=

# Credenciales ficticias (canarios) usadas para medir fugas de informacion.
# NUNCA credenciales reales: este es un laboratorio aislado.
SPT_SECRET=SPT-DEMO-8841
RRHH_SECRET=RRHH-DEMO-2291

HF_TOKEN=

# --- EXTENSIONES OPCIONALES (todas apagadas por defecto) --------------------

# Parte A (Excessive Agency): modelos que reciben las herramientas SIMULADAS
# enviar_correo / consultar_base_datos (proxy/herramientas.py -- no envian ni
# consultan nada real). Lista separada por comas. Vacio = ninguno, el proxy se
# comporta exactamente como en el nucleo del proyecto.
MODELOS_CON_HERRAMIENTAS=

# Proteger un modelo servido por OTRA API (openai: tipo chat/completions, local o remota;
# anthropic) en vez de Ollama. Vacio = todo lo atiende Ollama, como siempre. Objeto JSON en
# una linea, SIN secretos; el nombre es el que manda el cliente en `modelo`. Es una variante
# APARTE del experimento (sus eventos salen con es_extension); guia y limites en
# docs/MODELO_PROTEGIDO_REMOTO.md. Ejemplo:
#   MODELOS_REMOTOS={"asistente-nube":{"backend":"anthropic","modelo":"<id>","sistema_archivo":"/app/sistemas/a.txt"}}
MODELOS_REMOTOS=
#   Claves de los proveedores (solo aqui, nunca en el JSON):
MODELO_PROTEGIDO_OPENAI_API_KEY=
MODELO_PROTEGIDO_ANTHROPIC_API_KEY=
#   Hosts de TU organizacion (nombres exactos, separados por comas): HTTPS y clave, sin permiso.
MODELO_PROTEGIDO_HOSTS_PROPIOS=
#   PERMISO para un TERCERO. Vacio = apagado. Con 1, cada prompt (con su system prompt y el
#   canario) y su respuesta pasan por un tercero, FUERA del laboratorio: solo con aprobacion
#   del equipo (docs/CONFLICTOS_RESUELTOS.md, conflicto 6) y revisando sus terminos de uso.
MODELO_PROTEGIDO_PERMITIR_TERCEROS=

# Memoria de decisiones humanas (opcional; docs/MEMORIA_DE_DECISIONES.md). 1 = cuando un humano
# RECHAZA una peticion retenida, el proxy la recuerda y rechaza sola la proxima vez que llegue
# identica (mismo modelo). Persistente: se guarda en ./memoria/rechazos.jsonl. Solo actua con
# aprobacion_humana activa. NO la actives en una corrida del experimento (bajaria el ASR de
# C5/C6 artificialmente): los resultados de C0-C6 se midieron sin ella.
MEMORIA_RECHAZOS=
MEMORIA_RECHAZOS_MAXIMO=5000
#   0 = guardar solo la huella, sin la vista previa de 60 caracteres del mensaje.
MEMORIA_RECHAZOS_VISTA_PREVIA=1

# Parte B (notificaciones cuando aprobacion humana encola una peticion). Cada
# canal es independiente y solo existe si TODAS sus variables estan definidas.
# Estos valores son secretos: viven solo en tu .env local, nunca en el repo.
#   Webhook generico (p. ej. un endpoint de prueba local):
NOTIFICAR_WEBHOOK_URL=
#   Slack (incoming webhook, debe ser https://):
NOTIFICAR_SLACK_WEBHOOK_URL=
#   Enlace a la consola de revision que se agrega a TODOS los avisos (Slack,
#   correo, WhatsApp). Direccion donde se abre el proxy, sin ruta: el aviso
#   termina en <esto>/revision/ui. Vacio = los avisos salen sin enlace.
REVISION_URL_BASE=
#   Correo por SMTP (STARTTLS en el puerto 587; SMTP_SSL=1 para SMTPS/465):
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
NOTIFICAR_CORREO_DESTINO=
#   WhatsApp, via la API de Twilio (el sandbox sirve para probar):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_ORIGEN=
NOTIFICAR_WHATSAPP_DESTINO=

# Exportacion de eventos a Wazuh (proxy/siem.py). Ruta DENTRO del contenedor
# del archivo JSON Lines que vigila Wazuh; con docker-compose se monta
# ./docs/siem/exportados en /app/siem, asi que el valor habitual es
# /app/siem/ironveil.json. Vacio = apagada. Ver docs/siem/wazuh/LEEME.md.
SIEM_ARCHIVO_WAZUH=

# --- Login de la consola de revision humana (http://localhost:8000/revision/ui) ---
# Vacio = sin login (modo laboratorio, como antes). Con cuentas definidas, la
# consola y los endpoints /revision exigen sesion. Cada cuenta:
#   usuario:rol:hash   (rol = revisor, que decide, u observador, que solo ve)
# Cuenta de demo lista para usar (usuario admin, clave aleatoria que queda en
# credenciales-demo.local.txt, ignorado por Git):
#   python -m proxy.auth --demo
# O el hash de una cuenta a tu gusto, SIN mostrar la clave:
#   python -m proxy.auth USUARIO revisor
# y se pega aqui; varias cuentas se separan con comas, sin espacios.
REVISION_USUARIOS=
# Minutos de inactividad antes de cerrar la sesion.
REVISION_SESION_MINUTOS=30
# La cookie de sesion es Secure. Los navegadores la aceptan en
# http://localhost; ponla en 0 solo si accedes por HTTP desde otra IP/host.
REVISION_COOKIE_SECURE=1

# --- Pantalla de chat de la demo (http://localhost:8000/demo) ---
# 1 = activa; vacio = apagada (por defecto). Una pantalla tipo chat que usa
# POST /chat: escribes, recibes la respuesta. Lo que hizo cada mecanismo queda
# en los logs y en el SIEM, no en la pantalla. Es para laboratorio y presentacion.
IRONVEIL_DEMO=

